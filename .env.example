# Copy to `.env` for local development, and set the same values in
# Netlify → Site configuration → Environment variables → redeploy.
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# The anon/publishable key is DESIGNED to be public — Row Level Security is
# what actually protects your data. Never put the `service_role` key here.

# Supabase project URL
VITE_SUPABASE_URL=https://motpzepzmgenmufnypuv.supabase.co

# Supabase publishable (anon) key
VITE_SUPABASE_ANON_KEY=sb_publishable_0ykWXct9kZjrf5I1W44Qrw_99nIc1P0
